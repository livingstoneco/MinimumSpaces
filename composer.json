{
	"name": "livingstoneco/minimum-spaces",
	"description": "Laravel validation rule requiring a minimum number of spaces in a field",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": "^8.2",
		"illuminate/contracts": "^11.0|^12.0",
		"illuminate/support": "^11.0|^12.0",
		"illuminate/validation": "^11.0|^12.0"
	},
	"autoload": {
		"psr-4": {
			"MinimumSpaces\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MinimumSpaces\\Tests\\": "tests/"
		}
	},
	"require-dev": {
		"orchestra/testbench": "^9.4|^10.0",
		"phpunit/phpunit": "^11.0"
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	},
	"extra": {
		"laravel": {
			"providers": [
				"MinimumSpaces\\MinimumSpacesServiceProvider"
			]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
